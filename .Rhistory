library(tidyverse)
tabla = tibble(prev = seq(0.05,0.95,0.05)) %>%
mutate(nenf = zeta*sens*(1-sens)/d^2,
nsan = zeta*esp*(1-esp)/d^2,
n = case_when(nenf > nsan ~ nenf,
nsan > nenf ~ nsan,
TRUE ~ nsan))
esp = 0.75
sens = 0.85
d = 0.1
alfa = 0.05
zeta = qnorm(p = 1-(alfa/2))
